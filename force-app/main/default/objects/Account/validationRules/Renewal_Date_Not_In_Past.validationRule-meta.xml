<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Renewal_Date_Not_In_Past</fullName>
    <active>true</active>
    <description>Blocks saving an Account whose Renewal Date is earlier than today.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Renewal_Date__c)), Renewal_Date__c &lt; TODAY())</errorConditionFormula>
    <errorDisplayField>Renewal_Date__c</errorDisplayField>
    <errorMessage>Renewal Date can’t be in the past</errorMessage>
</ValidationRule>
